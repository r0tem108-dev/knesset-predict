# Leave MONGODB_URI empty to auto-run an embedded MongoDB (mongodb-memory-server)
# that persists to ./.mongo-data — great for local development with zero setup.
#
# For a real deployment, set this to a MongoDB Atlas / self-hosted connection string:
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/knesset-predict
MONGODB_URI=

# The election that groups are created against by default (see scripts/seed.ts)
DEFAULT_ELECTION_SLUG=knesset-26

# Base URL used to build shareable invite links (no trailing slash)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
